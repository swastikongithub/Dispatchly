<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core, PostGIS queries, Redis, OSRM client. Implements the Application ports. -->

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" />
    <!-- dotnet-ef migrations only (with DesignTimeDbContextFactory); never shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central Delhi's named main roads from OpenStreetMap (tools/fetch-delhi-streets.mjs). -->
    <EmbeddedResource Include="Streets\delhi-streets.json" LogicalName="Dispatchly.Infrastructure.Streets.delhi-streets.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dispatchly.Application\Dispatchly.Application.csproj" />
    <ProjectReference Include="..\Dispatchly.Domain\Dispatchly.Domain.csproj" />
  </ItemGroup>

</Project>
