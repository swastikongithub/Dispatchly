  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dispatchly.Application\Dispatchly.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dispatchly.UnitTests" />
  </ItemGroup>

</Project>
