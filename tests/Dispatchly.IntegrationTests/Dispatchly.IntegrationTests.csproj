<Project Sdk="Microsoft.NET.Sdk">

  <!-- API and database tests against a real PostGIS (Testcontainers), including the
       50-concurrent-orders assignment test. Tests arrive with the backend core (W2). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Exit code 8 = "zero tests ran". Remove this line when the first test lands (W2). -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dispatchly.Api\Dispatchly.Api.csproj" />
    <ProjectReference Include="..\..\src\Dispatchly.Infrastructure\Dispatchly.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
