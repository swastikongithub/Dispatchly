          },
          "stats": {
            "$ref": "#/components/schemas/LiveStats"
          },
          "restaurants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestaurantPin"
            }
          }
        }
      },
      "LiveStats": {
        "required": [
          "ridersOnline",
