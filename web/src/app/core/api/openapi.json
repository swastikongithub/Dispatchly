        }
      },
      "DropRequest": {
        "required": [
          "lat",
          "lng",
          "address",
          "area",
          "label"
        ],
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "label": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DropStop": {
        "required": [
          "customerFirstName",
          "label",
          "address",
          "area",
          "location"
        ],
        "type": "object",
        "properties": {
          "customerFirstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "label": {
            "type": [
              "null",
              "string"
            ]
          },
          "address": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Position"
          }
        }
      },
      "EtaChanged": {
        "required": [
          "at",
          "code",
          "estimatedDeliveryAt",
          "isLate",
          "minutesLate"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "string"
          },
          "estimatedDeliveryAt": {
            "type": "string",
            "format": "date-time"
          },
          "isLate": {
            "type": "boolean"
          },
          "minutesLate": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LiveRider": {
        "required": [
          "id",
          "name",
          "vehicle",
          "plate",
          "phone",
          "status",
          "location",
          "bearing",
          "orderCode",
          "onlineSince",
          "deliveriesToday"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "vehicle": {
            "type": "string"
          },
          "plate": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RiderStatus"
          },
          "location": {
            "$ref": "#/components/schemas/Position"
          },
          "bearing": {
            "type": "number",
            "format": "double"
          },
          "orderCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "onlineSince": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "deliveriesToday": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LiveSnapshot": {
        "required": [
          "at",
          "riders",
          "orders",
          "stats",
          "restaurants"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "riders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LiveRider"
