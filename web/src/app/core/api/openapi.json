  "components": {
    "schemas": {
      "CustomerAddress": {
        "required": [
          "label",
          "address",
          "area",
          "location"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Position"
          }
        }
      },
      "DeliverRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "DeliveryResult": {
        "required": [
          "code",
          "earnedPaise",
          "rider"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "earnedPaise": {
            "type": "integer",
            "format": "int32"
          },
          "rider": {
            "$ref": "#/components/schemas/RiderSelf"
          }
        }
      },
      "DemoSession": {
        "required": [
          "token",
          "expiresAt",
          "role",
          "name",
          "riderId",
          "customerId"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "name": {
            "type": "string"
          },
          "riderId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "customerId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "DemoSignInRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
