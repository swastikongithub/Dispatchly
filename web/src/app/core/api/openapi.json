      "LocationUpdate": {
        "required": [
          "lat",
          "lng",
          "bearing"
        ],
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "bearing": {
            "type": [
