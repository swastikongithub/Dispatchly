          "readyAt": {
            "type": "string",
            "format": "date-time"
          },
          "promisedBy": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedDeliveryAt": {
            "type": "string",
            "format": "date-time"
          },
          "assignedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "pickedUpAt": {
