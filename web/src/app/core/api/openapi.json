            "format": "int32"
          },
          "runningLate": {
            "type": "integer",
            "format": "int32"
          },
          "needsRider": {
            "type": "integer",
            "format": "int32"
          },
          "ridersFree": {
            "type": "integer",
            "format": "int32"
          },
          "ridersOnDelivery": {
            "type": "integer",
            "format": "int32"
          },
          "deliveredToday": {
            "type": "integer",
            "format": "int32"
          }
        }
