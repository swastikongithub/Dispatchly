# Copy this file to .env (git-ignored) and fill in your own values:
#   cp .env.example .env
# Never commit .env.

# PostgreSQL + PostGIS
POSTGRES_DB=dispatchly
POSTGRES_USER=dispatchly
# Required. Pick any strong local password.
POSTGRES_PASSWORD=

# Host ports (bound to 127.0.0.1 only). Change them if something else already
# uses them, e.g. a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
